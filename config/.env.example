# Конфигурация решения хакатона «Цифровое здоровье»
# Скопируйте в корень проекта: cp config/.env.example .env
# НЕ коммитьте .env в git!

# --- Общее ---
APP_NAME=team-solution
TRACK=1
# 1 = Виртуальная гистотопограмма
# 2 = Прогноз заболеваемости и выживаемости
# 3 = AI-ассистент для научных исследований
ENVIRONMENT=development
LOG_LEVEL=INFO

# --- Пути к данным ---
RAW_DATA_PATH=data/raw/
PROCESSED_DATA_PATH=data/processed/
MODEL_SAVE_PATH=models/

# --- Трек 1: гистотопограмма ---
# MRXS_DATA_DIR=data/raw/mrxs/
# OUTPUT_IMAGE_PATH=data/processed/reconstruction.tif
# MRXS_TILE_SIZE=2048

# --- Трек 2: прогноз ---
# REGISTRY_CSV=data/raw/registry.csv
# TARGET_COLUMN=survival_months
# RANDOM_SEED=42
# TRAIN_TEST_SPLIT=0.8

# --- Трек 3: AI-ассистент ---
# LLM: Yandex AI Studio через OpenAI-совместимый API (plan §5).
# folder_id и секретный ключ — из консоли YC (см. README/DEPLOY).
LLM_PROVIDER=yandex
YANDEX_API_KEY=                                   # секретный ключ сервисного аккаунта
YANDEX_FOLDER_ID=                                 # вшивается в URI: gpt://<folder>/<model>
LLM_MODEL=qwen3.6-35b-a3b/latest                  # одна модель на все роли (для старта)
OPENAI_BASE_URL=https://ai.api.cloud.yandex.net/v1
LLM_TEMPERATURE=0
LLM_MAX_OUTPUT_TOKENS=16384
# Поиск (P1): NCBI E-utilities, 10 rps с ключом.
# NCBI_API_KEY=
# OPENALEX_EMAIL=you@example.com                  # polite pool

# --- API / демо (опционально) ---
# API_HOST=0.0.0.0
# API_PORT=8000
